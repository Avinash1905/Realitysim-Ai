# Add your Gemini, OpenAI, or OpenRouter API Key here:
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database configuration (Defaults to local SQLite if PostgreSQL not configured)
DATABASE_URL=sqlite:///realitysim.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:password@localhost:5432/realitysim
